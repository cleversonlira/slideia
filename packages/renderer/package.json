{
  "name": "@apresenta/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsx scripts/build-player.ts",
    "render": "tsx scripts/build-player.ts && tsx src/node/cli.ts",
    "examples": "tsx scripts/build-player.ts && tsx scripts/build-examples.ts"
  },
  "dependencies": {
    "@apresenta/core": "workspace:*",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.59.0"
  }
}
