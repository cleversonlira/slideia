# Remote mode configuration (node packages/server/dist/remote.js, Docker or Fly.io).
# Copy to .env and fill in. Never commit real secrets.

# --- Required in production -------------------------------------------------
PUBLIC_URL=https://apresenta.example.com          # public https base URL (no trailing slash)
DATABASE_URL=postgres://user:password@host:5432/apresenta
# DATABASE_URL=pglite:./data/pg                   # embedded Postgres (single instance, no install)

# --- Server -------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
TRUST_PROXY=1                                     # behind a proxy/load balancer (Fly.io, Railway, Caddy…)
DATA_DIR=/data                                    # disk blobs and PGlite data
PRODUCT_NAME=SlideIA
SUPPORT_EMAIL=suporte@example.com
OPERATOR_NAME=                                   # data controller named in /privacidade and /termos

# --- Keys (generated and stored in the database when empty) -------------------
JWT_PRIVATE_KEY=                                  # EC P-256 PKCS#8 PEM; use \n for newlines
SIGNING_KEY=                                      # random string for signed links (≥ 32 chars)

# --- Images -------------------------------------------------------------------
BLOB_DRIVER=disk                                  # disk | s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                                      # e.g. https://<account>.r2.cloudflarestorage.com or Tigris
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
S3_CREATE_BUCKET=0

# --- E-mail (verification, password reset) --------------------------------------
MAIL_DRIVER=console                               # console | smtp | resend
MAIL_FROM=Apresenta <nao-responda@example.com>
SMTP_URL=                                         # smtp://user:pass@smtp.example.com:587
RESEND_API_KEY=

# --- Sign in with Google (optional) ---------------------------------------------
GOOGLE_CLIENT_ID=                                 # redirect URI: $PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_SECRET=

# --- ChatGPT app directory ------------------------------------------------------
OPENAI_APPS_CHALLENGE_TOKEN=                      # served at /.well-known/openai-apps-challenge
OAUTH_STATIC_CLIENTS=                             # JSON: [{"client_id":"…","client_secret":"…","redirect_uris":["…"],"client_name":"ChatGPT"}]

# --- Review/demo account (no 2FA), created with the example presentations -------
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Limits per account -----------------------------------------------------------
APRESENTA_LIMIT_PRESENTATIONS=100
APRESENTA_LIMIT_SLIDES=100
APRESENTA_LIMIT_IMAGE_BYTES=10485760
APRESENTA_LIMIT_STORAGE_BYTES=209715200

# --- Tokens and links -------------------------------------------------------------
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
LINK_TTL=86400

# --- Observability ----------------------------------------------------------------
METRICS_TOKEN=                                    # GET /metrics with "Authorization: Bearer <token>"

# --- Development only ---------------------------------------------------------------
APRESENTA_DEV=0                                   # 1: http PUBLIC_URL, e-mail links on screen, loopback CIMD
